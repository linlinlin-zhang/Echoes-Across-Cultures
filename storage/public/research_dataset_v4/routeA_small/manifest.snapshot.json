      "users_per_culture": 24,
      "tracks_per_user": 40,
      "genre_column": "coarse_label",
      "mode": "single_culture",
      "seed": 42
    },
    "mixed": {
      "enabled": true,
      "users_per_culture": 24,
      "tracks_per_user": 40,
      "genre_column": "coarse_label",
      "mode": "mixed_culture",
      "secondary_cultures": 2,
      "home_share": 0.6,
      "seed": 42
    }
  },
  "embeddings": {
    "culturemert": {
      "enabled": true,
      "model_id": "ntua-slp/CultureMERT-95M",
