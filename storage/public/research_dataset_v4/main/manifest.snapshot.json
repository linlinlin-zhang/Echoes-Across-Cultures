      "culture": "russia"
    },
    {
      "dataset_id": "research_dataset_v3/turkey",
      "local_metadata": "storage/public/research_dataset_v3/turkey/metadata.csv",
      "culture": "turkey"
    }
  ],
  "merge": {
    "strategy": "dedup",
    "dedup_key": "track_id"
  },
  "harmonize": {
    "label_source": "coarse_label",
    "language_normalize": true,
    "fill_is_instrumental": true
  },
  "interaction_protocol": {
    "single": {
      "enabled": true,
      "users_per_culture": 24,
      "tracks_per_user": 40,
      "genre_column": "coarse_label",
      "mode": "single_culture",
      "seed": 42
    },
    "mixed": {
      "enabled": true,
      "users_per_culture": 24,
      "tracks_per_user": 40,
      "genre_column": "coarse_label",
      "mode": "mixed_culture",
      "secondary_cultures": 2,
      "home_share": 0.6,
      "seed": 42
    }
  },
  "embeddings": {
    "culturemert": {
      "enabled": true,
      "model_id": "ntua-slp/CultureMERT-95M",
      "pooling": "mean",
      "layer_indices": [
        -4,
        -3,
        -2,
        -1
      ],
      "layer_weights": null,
      "max_seconds": 30.0,
      "window_count": 3,
      "window_strategy": "uniform",
      "window_aggregate": "mean",
      "skip_errors": false
    },
    "gemini": {
      "enabled": true,
      "model_id": "gemini-embedding-2-preview",
      "api_key_file": "E:/Desktop/Echo/configs/embedding/gemini_api_key.local.txt",
      "output_dimensionality": 768,
      "max_seconds": 30.0,
      "window_count": 3,
      "window_strategy": "uniform",
      "window_aggregate": "mean",
      "skip_errors": false
    }
  },
  "validation": {
    "min_tracks_per_culture": 30,
    "max_culture_imbalance_ratio": 20.0,
    "max_unknown_track_ratio": 0.01,
    "max_duplicate_user_track_ratio": 0.05,
    "max_zero_norm_ratio": 0.05,
    "min_interactions_per_user": 5
  }
}