      "local_metadata": "storage/public/research_dataset_v3/great_britain/metadata.csv",
      "culture": "great_britain"
    },
    {
      "dataset_id": "research_dataset_v3/india",
      "local_metadata": "storage/public/research_dataset_v3/india/metadata.csv",
      "culture": "india"
    },
    {
      "dataset_id": "research_dataset_v3/indonesia",
      "local_metadata": "storage/public/research_dataset_v3/indonesia/metadata.csv",
      "culture": "indonesia"
    },
    {
      "dataset_id": "research_dataset_v3/italy",
      "local_metadata": "storage/public/research_dataset_v3/italy/metadata.csv",
      "culture": "italy"
    },
    {
      "dataset_id": "research_dataset_v3/modern_english_pop",
      "local_metadata": "storage/public/research_dataset_v3/modern_english_pop/metadata.csv",
      "culture": "modern_english_pop"
