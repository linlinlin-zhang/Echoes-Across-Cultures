# Copy this file to echo-proxy.env on the cloud server and edit the values.

# Public domain that points to the cloud server.
ECHO_DOMAIN=example.com

# Optional additional names, separated by spaces. Example: www.example.com
ECHO_EXTRA_DOMAINS=www.example.com

# Windows host Tailscale IPv4 and Echo port.
ECHO_UPSTREAM=100.99.177.67:8000

# LetsEncrypt email. Leave empty to let certbot prompt in interactive mode.
ECHO_EMAIL=

# Set false before DNS has propagated, then rerun with true.
ECHO_ENABLE_HTTPS=true

# If true, install and enable ufw with OpenSSH, HTTP, and HTTPS allowed.
# Keep false if the server uses a custom SSH/firewall setup.
ECHO_CONFIGURE_UFW=false

# Optional reusable Tailscale auth key. Leave empty for browser login.
ECHO_TAILSCALE_AUTHKEY=

# Optional cloud node name in the tailnet.
ECHO_TAILSCALE_HOSTNAME=echo-proxy

# Require the cloud server to reach the local Echo health endpoint before nginx is reloaded.
ECHO_REQUIRE_UPSTREAM_HEALTH=true

# Uploads can include large audio files.
ECHO_CLIENT_MAX_BODY_SIZE=500m
