# Local machine worker settings for CultureMERT/DCAS-heavy requests.
# Copy to a private local file, set a strong shared token, then run the worker.

ECHO_STORAGE_ROOT=storage
ECHO_USER_DATA_DIR=storage/user_data
ECHO_COOKIE_SECURE=false

# Require cloud requests to include X-Echo-Worker-Token.
ECHO_WORKER_REQUIRE_TOKEN=true
ECHO_WORKER_SHARED_TOKEN=change-this-to-a-long-random-secret

# Do not set ECHO_MAINLINE_WORKER_URL on the worker itself, otherwise it will proxy back out.
ECHO_MAINLINE_WORKER_URL=
ECHO_MAINLINE_WORKER_TOKEN=
ECHO_MAINLINE_WORKER_TIMEOUT_SECONDS=900

KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_ENDPOINT=https://api.moonshot.cn/v1/chat/completions
