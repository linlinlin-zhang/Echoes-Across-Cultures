# Local machine worker settings for CultureMERT/DCAS-heavy requests.
# Copy to a private local file, set a strong shared token, then run the worker.

ECHO_STORAGE_ROOT=storage
ECHO_USER_DATA_DIR=storage/user_data
ECHO_COOKIE_SECURE=false

# Require cloud requests to include X-Echo-Worker-Token.
ECHO_WORKER_REQUIRE_TOKEN=true
ECHO_WORKER_SHARED_TOKEN=change-this-to-a-long-random-secret

# Do not set ECHO_MAINLINE_WORKER_URL on the worker itself, otherwise it will proxy back out.
ECHO_MAINLINE_WORKER_URL=
ECHO_MAINLINE_WORKER_TOKEN=
ECHO_MAINLINE_WORKER_TIMEOUT_SECONDS=900
ECHO_MAINLINE_PRELOAD=true
ECHO_MAINLINE_PRELOAD_CUDA=false
ECHO_MAINLINE_METADATA_PATH=public/merged/metadata_merged_local_audio.csv
ECHO_MAINLINE_TRACKS_PATH=public/merged/tracks_culturemert.npz
ECHO_MAINLINE_MODEL_PATH=models/dcas_full_v4_main_culturemert_stage3.pt

# CultureMERT model loading for uploaded-audio recommendation.
# Keep local-files-only true after the model has been downloaded once; this avoids
# Hugging Face HEAD checks during live requests.
ECHO_CULTUREMERT_MODEL_ID=ntua-slp/CultureMERT-95M
ECHO_CULTUREMERT_CACHE_DIR=
ECHO_CULTUREMERT_REVISION=
ECHO_CULTUREMERT_LOCAL_FILES_ONLY=true

KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_ENDPOINT=https://api.moonshot.cn/v1/chat/completions
KIMI_WEB_SEARCH_FORMULA=moonshot/web-search:latest
ECHO_KIMI_COUNTRY_MIN_CONFIDENCE=0.68
