# Echo public-host runtime settings.
# Copy to configs/public_host.env for the Windows machine that runs the full app.

ECHO_STORAGE_ROOT=storage
ECHO_USER_DATA_DIR=storage/user_data

# Set this to true after visitors use the site through HTTPS on your domain.
# Keep false if you are testing directly through http://127.0.0.1:8000.
ECHO_COOKIE_SECURE=false

# 30k CultureMERT mainline artifacts. The local-audio metadata keeps the
# enriched merged fields while pointing audio_path at storage/cloud_audio_10gb.
ECHO_MAINLINE_METADATA_PATH=public/merged/metadata_merged_local_audio.csv
ECHO_MAINLINE_TRACKS_PATH=public/merged/tracks_culturemert.npz
ECHO_MAINLINE_MODEL_PATH=models/dcas_full_v4_main_culturemert_stage3.pt

# This machine is the real host, so it should not proxy recommendation calls out.
ECHO_MAINLINE_WORKER_URL=
ECHO_MAINLINE_WORKER_TOKEN=
ECHO_MAINLINE_WORKER_TIMEOUT_SECONDS=900
ECHO_WORKER_REQUIRE_TOKEN=false
ECHO_WORKER_SHARED_TOKEN=

# Uploaded-audio embedding provider.
# Use culturemert for fully local extraction, or gemini if GEMINI_API_KEY is set
# and the mainline tracks/model are in the same Gemini embedding space.
ECHO_UPLOAD_EMBEDDING_PROVIDER=culturemert

GEMINI_API_KEY=
ECHO_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
ECHO_GEMINI_EMBEDDING_API_BASE=https://generativelanguage.googleapis.com/v1beta
ECHO_GEMINI_EMBEDDING_DIM=768
ECHO_GEMINI_EMBEDDING_MAX_SECONDS=30
ECHO_GEMINI_EMBEDDING_SAMPLE_RATE_HZ=16000
ECHO_GEMINI_EMBEDDING_WINDOW_COUNT=1
ECHO_GEMINI_EMBEDDING_WINDOW_STRATEGY=single
ECHO_GEMINI_EMBEDDING_WINDOW_AGGREGATE=mean
ECHO_GEMINI_EMBEDDING_TIMEOUT_SECONDS=180
ECHO_GEMINI_EMBEDDING_MAX_RETRIES=5
ECHO_GEMINI_EMBEDDING_RETRY_BACKOFF_SECONDS=2.0

KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_ENDPOINT=https://api.moonshot.cn/v1/chat/completions
KIMI_WEB_SEARCH_FORMULA=moonshot/web-search:latest
ECHO_KIMI_COUNTRY_MIN_CONFIDENCE=0.68
