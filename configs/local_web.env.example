# Full local website exposed through the cloud server's SSH reverse tunnel.
# Copy to configs/local_web.env; keep API keys only in that ignored file.
ECHO_STORAGE_ROOT=storage
ECHO_USER_DATA_DIR=storage/user_data
ECHO_COOKIE_SECURE=true
ECHO_WORKER_REQUIRE_TOKEN=false
ECHO_WORKER_SHARED_TOKEN=
ECHO_MAINLINE_WORKER_URL=
ECHO_MAINLINE_WORKER_TOKEN=
# Optional alternate address of the same server; its SSH host key must match.
ECHO_SSH_FALLBACK_HOST=
ECHO_MAINLINE_LOCAL_RECOMMENDER_ENABLED=true
ECHO_UPLOAD_EMBEDDING_PROVIDER=culturemert
ECHO_CULTUREMERT_MODEL_ID=ntua-slp/CultureMERT-95M
ECHO_CULTUREMERT_LOCAL_FILES_ONLY=true
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_ENDPOINT=https://api.moonshot.cn/v1/chat/completions

# Public exhibition deployment; these do not contain credentials.
ECHO_PUBLIC_MODE=true
ECHO_KEEP_AWAKE=true
ECHO_PREWARM_MAINLINE=true
