# Echo server runtime settings.
# Copy this file to /etc/echo/echo.env on Ubuntu, then edit paths and secrets.

ECHO_STORAGE_ROOT=/srv/echo/storage
ECHO_USER_DATA_DIR=/srv/echo/storage/user_data
# Set true only after HTTPS is enabled at the reverse proxy.
ECHO_COOKIE_SECURE=false

# Optional AI provider settings. Keep real keys outside git.
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_ENDPOINT=https://api.moonshot.cn/v1/chat/completions
