# Echo server runtime settings.
# Copy this file to /etc/echo/echo.env on Ubuntu, then edit paths and secrets.

ECHO_STORAGE_ROOT=/srv/echo/storage
ECHO_USER_DATA_DIR=/srv/echo/storage/user_data
# Optional: point catalog browsing/audio streaming at the compressed cloud copy.
# Frontend pages still use /api/mainline/*; this is only a server filesystem path.
ECHO_MAINLINE_METADATA_PATH=/srv/echo/cloud_audio_10gb/metadata_merged.csv
# Optional: point the recommender at Gemini-built mainline artifacts when
# ECHO_UPLOAD_EMBEDDING_PROVIDER=gemini. Keep tracks/model in the same embedding
# space as uploaded Gemini audio embeddings.
# ECHO_MAINLINE_TRACKS_PATH=/srv/echo/storage/public/research_dataset_v4/main/tracks_gemini_embedding2_mw3.npz
# ECHO_MAINLINE_MODEL_PATH=/srv/echo/storage/models/dcas_full_v4_main_gemini_stage3.pt
# Set true only after HTTPS is enabled at the reverse proxy.
ECHO_COOKIE_SECURE=false

# Cloud-to-local mainline worker. Leave empty to run recommendation locally.
# Point this at a public tunnel to your own computer, for example:
# ECHO_MAINLINE_WORKER_URL=https://your-worker.example.com
ECHO_MAINLINE_WORKER_URL=
ECHO_MAINLINE_WORKER_TOKEN=
ECHO_MAINLINE_WORKER_TIMEOUT_SECONDS=900

# Enable these only on the local worker process exposed through your tunnel.
ECHO_WORKER_REQUIRE_TOKEN=false
ECHO_WORKER_SHARED_TOKEN=

# Uploaded-audio embedding provider for /api/mainline/upload_recommend.
# culturemert = local Hugging Face CultureMERT extraction.
# gemini = cloud API extraction with Gemini Embedding 2; bypasses ECHO_MAINLINE_WORKER_URL.
ECHO_UPLOAD_EMBEDDING_PROVIDER=culturemert

# Gemini Embedding 2 settings. Required only when ECHO_UPLOAD_EMBEDDING_PROVIDER=gemini.
# Keep the real key in /etc/echo/echo.env or your secret manager, never in git.
GEMINI_API_KEY=
ECHO_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
ECHO_GEMINI_EMBEDDING_API_BASE=https://generativelanguage.googleapis.com/v1beta
ECHO_GEMINI_EMBEDDING_DIM=768
ECHO_GEMINI_EMBEDDING_MAX_SECONDS=30
ECHO_GEMINI_EMBEDDING_SAMPLE_RATE_HZ=16000
ECHO_GEMINI_EMBEDDING_WINDOW_COUNT=1
ECHO_GEMINI_EMBEDDING_WINDOW_STRATEGY=single
ECHO_GEMINI_EMBEDDING_WINDOW_AGGREGATE=mean
ECHO_GEMINI_EMBEDDING_TIMEOUT_SECONDS=180
ECHO_GEMINI_EMBEDDING_MAX_RETRIES=5
ECHO_GEMINI_EMBEDDING_RETRY_BACKOFF_SECONDS=2.0

# Optional AI provider settings. Keep real keys outside git.
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_ENDPOINT=https://api.moonshot.cn/v1/chat/completions
KIMI_WEB_SEARCH_FORMULA=moonshot/web-search:latest
ECHO_KIMI_COUNTRY_MIN_CONFIDENCE=0.68
